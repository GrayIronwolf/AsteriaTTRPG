rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserData(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasValidMarketPricing(data) {
      return data.keys().hasAll(['marketValue', 'marketPrice']) &&
        data.marketValue is number &&
        data.marketPrice is number &&
        data.marketValue >= 0 &&
        data.marketPrice >= 0 &&
        (
          data.marketValue == 0 ||
          data.marketPrice == 0 ||
          data.marketValue < data.marketPrice
        );
    }

    function isCampaignOwner(data) {
      return signedIn() && data.ownerUid == request.auth.uid;
    }

    function activeV2Member(campaignId, uid) {
      let path = /databases/$(database)/documents/campaigns/$(campaignId)/members/$(uid);
      return exists(path) &&
        get(path).data.get('uid', '') == uid &&
        get(path).data.get('campaignId', '') == campaignId &&
        get(path).data.get('status', '') == 'active' &&
        get(path).data.get('role', '') in ['player','co-gm'];
    }

    function activeV2GM(campaignId, uid) {
      let path = /databases/$(database)/documents/campaigns/$(campaignId)/members/$(uid);
      return exists(path) &&
        get(path).data.get('uid', '') == uid &&
        get(path).data.get('campaignId', '') == campaignId &&
        get(path).data.get('status', '') == 'active' &&
        get(path).data.get('role', '') == 'co-gm';
    }

    function isCampaignMember(data, campaignId) {
      return signedIn() && (
        data.get('membershipSchemaVersion', 1) == 2
          ? (data.ownerUid == request.auth.uid || activeV2Member(campaignId, request.auth.uid))
          : (data.get('membershipSchemaVersion', 1) == 1 && (
            data.ownerUid == request.auth.uid ||
            request.auth.uid in data.get('gmUids', []) ||
            request.auth.uid in data.get('playerUids', []) ||
            data.get('roles', {}).get(request.auth.uid, '') in ['gm','player']
          ))
      );
    }

    function sharedCampaign(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
    }

    function canReadCampaignCharacter(campaignId) {
      return isCampaignMember(sharedCampaign(campaignId), campaignId);
    }

    function canWriteCampaignCharacter(campaignId, ownerUid) {
      return canReadCampaignCharacter(campaignId) && (ownerUid == request.auth.uid || isCampaignGM(campaignId));
    }

    function isLinkedCharacterOwner(campaignId, characterId) {
      let campaign = sharedCampaign(campaignId);
      return signedIn() &&
        campaign.keys().hasAll(['playerCharacterLinks']) &&
        campaign.playerCharacterLinks[characterId] == request.auth.uid;
    }

    function canUseCampaignSystems(campaignId) {
      return isCampaignMember(sharedCampaign(campaignId), campaignId);
    }

    function activeSession(campaignId) {
      let session = get(/databases/$(database)/documents/campaigns/$(campaignId)/liveSession/current).data;
      return session.status == 'active' && session.expiresAt is timestamp && request.time < session.expiresAt;
    }
    function safeCharacterEdit(campaignId) {
      return canWriteCampaignCharacter(campaignId, resource.data.ownerUid) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'initial', 'pronouns', 'age', 'appearance', 'origin', 'backstory',
          'family_tree', 'biography', 'description', 'gallery', 'image', 'portrait',
          'characterImage', 'dashboardPreferences', 'journal', 'updatedAt', 'status',
          'linkedCampaignIds', 'sharedCampaignId', 'sourceCharacterId', 'id'
        ]) &&
        request.resource.data.get('id', '') == resource.data.get('id', '') &&
        request.resource.data.get('sourceCharacterId', '') == resource.data.get('sourceCharacterId', '') &&
        request.resource.data.get('sharedCampaignId', '') == resource.data.get('sharedCampaignId', '');
    }

    function isCampaignGM(campaignId) {
      let campaign = sharedCampaign(campaignId);
      return signedIn() && (
        campaign.get('membershipSchemaVersion', 1) == 2
          ? (campaign.ownerUid == request.auth.uid || activeV2GM(campaignId, request.auth.uid))
          : (campaign.get('membershipSchemaVersion', 1) == 1 && (
            campaign.ownerUid == request.auth.uid ||
            request.auth.uid in campaign.get('gmUids', []) ||
            campaign.get('roles', {}).get(request.auth.uid, '') == 'gm'
          ))
      );
    }





    function linksOwnedCharacter(campaignId) {
      let characterId = request.resource.data.lastLinkedCharacterId;
      let linked = getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/characters/$(characterId)).data;
      return resource.data.get('membershipSchemaVersion', 1) == 1 && isCampaignMember(resource.data, campaignId) &&
        linked.ownerUid == request.auth.uid &&
        resource.data.get('playerCharacterLinks', {}).get(characterId, request.auth.uid) == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'party', 'players', 'characters', 'playerCharacterLinks',
          'activity', 'lastLinkedCharacterId', 'updatedAt'
        ]) &&
        request.resource.data.party.hasAll(resource.data.get('party', [])) &&
        request.resource.data.party.size() <= resource.data.get('party', []).size() + 1 &&
        characterId in request.resource.data.party &&
        request.resource.data.players.diff(resource.data.get('players', {})).affectedKeys().hasOnly([request.auth.uid]) &&
        characterId in request.resource.data.players[request.auth.uid].characterIds &&
        request.resource.data.characters.diff(resource.data.get('characters', {})).affectedKeys().hasOnly([characterId]) &&
        request.resource.data.characters[characterId].ownerUid == request.auth.uid &&
        request.resource.data.playerCharacterLinks.diff(resource.data.get('playerCharacterLinks', {})).affectedKeys().hasOnly([characterId]) &&
        request.resource.data.playerCharacterLinks[characterId] == request.auth.uid;
    }

    function matchingLinkedOwner(data, characterId, uid) {
      let campaignId = data.get('sharedCampaignId', '');
      let path = /databases/$(database)/documents/campaigns/$(campaignId)/characters/$(characterId);
      return campaignId == '' || !exists(path) || (
        get(path).data.ownerUid == uid &&
        get(path).data.get('sourceCharacterId', characterId) == data.get('sourceCharacterId', characterId)
      );
    }

    function sameCharacterIdentity() {
      return request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.get('sourceCharacterId', '') == resource.data.get('sourceCharacterId', '') &&
        request.resource.data.get('id', '') == resource.data.get('id', '');
    }

    // Account identity fields are Admin SDK only. All other private profile
    // fields remain owner-editable until a permanent account ID is assigned.
    function safeAccountProfileCreate(uid) {
      return request.resource.data.get('uid', uid) == uid &&
        !request.resource.data.keys().hasAny([
          'accountId', 'accountNumber', 'accountIdKey', 'accountIdAssignedAt'
        ]);
    }
    function safeAccountProfileUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.get('uid', uid) == uid &&
        !changed.hasAny([
          'accountId', 'accountNumber', 'accountIdKey', 'accountIdAssignedAt'
        ]) &&
        (!resource.data.keys().hasAny(['accountId']) ||
          !changed.hasAny(['username', 'usernameLower', 'uid']));
    }

    match /users/{uid} {
      allow read: if ownsUserData(uid);
      allow create: if ownsUserData(uid) && safeAccountProfileCreate(uid);
      allow update: if ownsUserData(uid) && safeAccountProfileUpdate(uid);
      allow delete: if ownsUserData(uid) && !resource.data.keys().hasAny(['accountId']);

      match /characters/{characterId} {
        allow read: if ownsUserData(uid);
        allow create: if ownsUserData(uid) && request.resource.data.ownerUid == uid &&
          matchingLinkedOwner(request.resource.data, characterId, uid);
        allow update: if ownsUserData(uid) && resource.data.ownerUid == uid &&
          request.resource.data.ownerUid == uid && matchingLinkedOwner(request.resource.data, characterId, uid);
        allow delete: if ownsUserData(uid);
      }
      match /{collectionId}/{document=**} {
        allow read, write: if collectionId != 'characters' && ownsUserData(uid);
      }
    }

    // Phase 1.3: permanent Account ID assignments and unique directory are
    // server-only. Never grant browser reads or writes to either collection.
    // Phase 1.2: exact friends lookup quotas are Admin-only. Never list them.
    // Phase 2.1: canonical social relationships and issuance quotas are Admin-only.
    // Never let a browser list relationship participants, determine block state,
    // forge a request, accept on another player's behalf or mint friendship.
    // Future Phase 2.2 actions must use authenticated Cloud Functions transactions.
    match /friendRelationships/{pairId} {
      allow get, list, create, update, delete: if false;
    }

    // Phase 2.3 server-only inbox read quotas. No client access.
    // Phase 4.1: recipient-private friend notification events are Admin-only.
    // Even their owner must use the separately gated authenticated callable.
    match /friendNotificationAccessThrottle/{uid} {
      allow get, list, create, update, delete: if false;
    }
    match /friendNotificationInbox/{uid} {
      allow read, write: if false;
      match /items/{notificationId} {
        allow read, write: if false;
      }
    }

    match /friendRequestInboxThrottle/{uid} {
      allow get, list, create, update, delete: if false;
    }

    match /friendRequestIssueThrottle/{uid} {
      allow get, list, create, update, delete: if false;
    }

    match /friendLookupThrottle/{uid} {
      allow read, write: if false;
    }

    match /accountIdAssignments/{uid} {
      allow read, write: if false;
    }
    match /accountIdRegistry/{accountIdKey} {
      allow read, write: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /campaignMemberProjections/{uid} {
      match /campaigns/{campaignId} {
        allow read: if ownsUserData(uid);
        allow write: if false;
      }
    }

    // Phase 6.1 server-only invitation credentials and issuance quotas.
    // Even campaign members and GMs never read token digests or email targets.
    // Phase 7.3: notifications are server-written and callable-readable by
    // their own authenticated recipient only. Browser cannot forge, list,
    // acknowledge or inspect any other account's inbox through Firestore.
    match /campaignNotificationInbox/{uid} {
      allow read, write: if false;
      match /items/{notificationId} {
        allow read, write: if false;
      }
    }

    match /campaignInvitationTokenIndex/{tokenDigest} {
      allow read, write: if false;
    }
    match /campaignInvitationIssueThrottle/{uid} {
      allow read, write: if false;
    }

    match /campaignInvites/{ucn} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && isCampaignOwner(sharedCampaign(request.resource.data.campaignId)) && sharedCampaign(request.resource.data.campaignId).get('membershipSchemaVersion', 1) == 1;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.campaignId == resource.data.campaignId && sharedCampaign(resource.data.campaignId).get('membershipSchemaVersion', 1) == 1;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid && sharedCampaign(resource.data.campaignId).get('membershipSchemaVersion', 1) == 1;
    }

    match /campaigns/{campaignId} {
      allow read: if isCampaignMember(resource.data, campaignId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.get('membershipSchemaVersion', 1) == 1;
      allow update: if (isCampaignOwner(resource.data) && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.get('membershipSchemaVersion', 1) == resource.data.get('membershipSchemaVersion', 1) && (resource.data.get('membershipSchemaVersion', 1) != 2 || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid','gmUids','playerUids','roles','players','membershipSchemaVersion','membershipRevision','joinPolicy','capacity','invites','inviteCode','uniqueCampaignCode'])) && (!resource.data.keys().hasAny(['ucn']) || request.resource.data.ucn == resource.data.ucn)) || linksOwnedCharacter(campaignId) || (
        isCampaignGM(campaignId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['image','imagePath','art','banner','coverImage','cover','updatedAt']) &&
        request.resource.data.get('image','') is string &&
        request.resource.data.get('imagePath','') is string &&
        request.resource.data.get('image','').size() <= 2048 &&
        request.resource.data.get('imagePath','').size() <= 500 &&
        (request.resource.data.get('image','') == '' || request.resource.data.get('image','').matches('https://.*')) &&
        (request.resource.data.get('imagePath','') == '' || request.resource.data.get('imagePath','').matches('campaigns/' + campaignId + '/artwork/.*'))
      );
      allow delete: if isCampaignOwner(resource.data);

      match /joinRequests/{requestUid} {
        // Canonical requests are server-written only. A player may read
        // only their own status, while active GMs may review requests.
        allow get: if signedIn() &&
          sharedCampaign(campaignId).get('membershipSchemaVersion', 1) == 2 &&
          (request.auth.uid == requestUid || isCampaignGM(campaignId));
        allow list: if sharedCampaign(campaignId).get('membershipSchemaVersion', 1) == 2 &&
          isCampaignGM(campaignId);
        allow create, update, delete: if false;
      }

      // Only authenticated Cloud Functions can issue and validate bearer
      // invitation records or view recipient restrictions.
      match /invitations/{inviteId} {
        allow read, write: if false;
        match /claims/{memberUid} {
          allow read, write: if false;
        }
      }

      match /members/{memberUid} {
        // Server-managed role/status, readable only by campaign owner, 
        // the member themselves, or active v2 co-GM.
        allow get: if signedIn() && sharedCampaign(campaignId).get('membershipSchemaVersion', 1) == 2 && (
          request.auth.uid == memberUid ||
          isCampaignOwner(sharedCampaign(campaignId)) ||
          isCampaignGM(campaignId)
        );
        allow list: if sharedCampaign(campaignId).get('membershipSchemaVersion', 1) == 2 && isCampaignGM(campaignId);
        allow write: if false;
      }

      match /characters/{characterId} {
        allow read: if canReadCampaignCharacter(campaignId);
        // Players import a sheet once. Live gameplay mutations use authenticated Functions.
        allow create: if sharedCampaign(campaignId).get('membershipSchemaVersion', 1) == 1 && (
          isCampaignGM(campaignId) || (
          canWriteCampaignCharacter(campaignId, request.resource.data.ownerUid) &&
          request.resource.data.ownerUid == request.auth.uid &&
          existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/characters/$(request.resource.data.sourceCharacterId)) &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/characters/$(request.resource.data.sourceCharacterId)).data.ownerUid == request.auth.uid
        ));
        // V2 gameplay records are created/archived only by authenticated server
        // transactions. Browser clients cannot recreate or erase a detached sheet.
        allow update: if resource.data.get('status','linked') == 'linked' &&
          request.resource.data.get('status','linked') == 'linked' &&
          ((isCampaignGM(campaignId) && sameCharacterIdentity()) || safeCharacterEdit(campaignId));
        allow delete: if sharedCampaign(campaignId).get('membershipSchemaVersion', 1) == 1 && isCampaignGM(campaignId);
      }

      // Trade terms and escrowed item details are not campaign-wide information.
      // Legacy trade arrays remain GM-readable for server migration, but players
      // only receive the sanitized public shop projection and their own requests.
      match /itemRequests/{requestId} {
        allow get, list: if isCampaignGM(campaignId) || (
          canUseCampaignSystems(campaignId) &&
          (resource.data.fromOwnerUid == request.auth.uid ||
           resource.data.toOwnerUid == request.auth.uid)
        );
        allow create, update, delete: if false;
      }

      match /systems/{systemId} {
        allow read: if canUseCampaignSystems(campaignId) && (
          (systemId == 'itemEcosystem' || systemId == 'gmWorkspace')
            ? isCampaignGM(campaignId) : true
        );
        // The public shop view may also be maintained by the existing
        // authenticated GM shop editor, but cannot contain private trade rows.
        allow create: if (systemId == 'itemPublic' && isCampaignGM(campaignId) &&
          request.resource.data.keys().hasOnly(['version','shops','partyLoot','sharedStorages','updatedAt'])) ||
          (systemId != 'itemPublic' && (isCampaignGM(campaignId) || (systemId == 'party-workspace' && canUseCampaignSystems(campaignId) && activeSession(campaignId) && request.resource.data.keys().hasOnly(['sharedNotes','sessionId','updatedBy','updatedAt']) && request.resource.data.sharedNotes is string && request.resource.data.sharedNotes.size() <= 20000 && request.resource.data.updatedBy == request.auth.uid));
        allow update: if (systemId == 'itemPublic' && isCampaignGM(campaignId) &&
          request.resource.data.keys().hasOnly(['version','shops','partyLoot','sharedStorages','updatedAt'])) ||
          (systemId != 'itemPublic' && (isCampaignGM(campaignId) || (systemId == 'party-workspace' && canUseCampaignSystems(campaignId) && activeSession(campaignId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedNotes','sessionId','updatedBy','updatedAt']) && request.resource.data.sharedNotes is string && request.resource.data.sharedNotes.size() <= 20000 && request.resource.data.updatedBy == request.auth.uid));
        allow delete: if systemId != 'itemPublic' && isCampaignOwner(sharedCampaign(campaignId));
      }

      match /liveSession/{sessionDocument} {
        allow read: if canUseCampaignSystems(campaignId);
        allow create, update: if isCampaignGM(campaignId);
        allow delete: if isCampaignOwner(sharedCampaign(campaignId));
      }

      match /sessions/{sessionId} {
        allow read: if canUseCampaignSystems(campaignId);
        allow create, update: if isCampaignGM(campaignId);
        allow delete: if isCampaignOwner(sharedCampaign(campaignId));

        match /presence/{uid} {
          allow read: if canUseCampaignSystems(campaignId);
          allow create, update: if canUseCampaignSystems(campaignId) && (ownsUserData(uid) || isCampaignGM(campaignId));
          allow delete: if canUseCampaignSystems(campaignId) && (ownsUserData(uid) || isCampaignGM(campaignId));
        }
      }

      match /events/{eventId} {
        allow read: if isCampaignGM(campaignId) ||
          (canUseCampaignSystems(campaignId) && resource.data.targetOwnerUid == request.auth.uid);
        allow create: if isCampaignGM(campaignId);
        allow update: if isCampaignGM(campaignId) || (
          canUseCampaignSystems(campaignId) &&
          !(resource.data.type in ['loot-reward','magic-element-reward']) &&
          request.resource.data.status == 'acknowledged' &&
          request.resource.data.acknowledged == true &&
          request.resource.data.acknowledgedBy == request.auth.uid &&
          resource.data.targetOwnerUid == request.auth.uid &&
          request.resource.data.targetOwnerUid == resource.data.targetOwnerUid &&
          request.resource.data.targetCharacterId == resource.data.targetCharacterId &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'deliveryStatus', 'acknowledged', 'acknowledgedBy',
            'acknowledgedAt', 'updatedAt'
          ])
        );
        allow delete: if isCampaignOwner(sharedCampaign(campaignId));
      }

      match /partyChat/{messageId} {
        allow read: if canUseCampaignSystems(campaignId);
        allow create: if canUseCampaignSystems(campaignId) && activeSession(campaignId) &&
          get(/databases/$(database)/documents/campaigns/$(campaignId)/characters/$(request.resource.data.characterId)).data.ownerUid == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 2000;
        allow update: if false;
        allow delete: if isCampaignGM(campaignId) ||
          (canUseCampaignSystems(campaignId) && resource.data.ownerUid == request.auth.uid);
      }
    }

    match /customItems/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        hasValidMarketPricing(request.resource.data);
      allow update: if signedIn() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        hasValidMarketPricing(request.resource.data);
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
