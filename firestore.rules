rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserData(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasValidMarketPricing(data) {
      return data.keys().hasAll(['marketValue', 'marketPrice']) &&
        data.marketValue is number &&
        data.marketPrice is number &&
        data.marketValue >= 0 &&
        data.marketPrice >= 0 &&
        (
          data.marketValue == 0 ||
          data.marketPrice == 0 ||
          data.marketValue < data.marketPrice
        );
    }

    function isCampaignOwner(data) {
      return signedIn() && data.ownerUid == request.auth.uid;
    }

    function isCampaignMember(data) {
      return signedIn() && (
        data.ownerUid == request.auth.uid ||
        (data.keys().hasAll(['gmUids']) && request.auth.uid in data.gmUids) ||
        (data.keys().hasAll(['playerUids']) && request.auth.uid in data.playerUids)
      );
    }

    function sharedCampaign(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
    }

    function canReadCampaignCharacter(campaignId) {
      return isCampaignMember(sharedCampaign(campaignId));
    }

    function canWriteCampaignCharacter(campaignId, ownerUid) {
      return signedIn() && (
        ownerUid == request.auth.uid ||
        isCampaignOwner(sharedCampaign(campaignId)) ||
        (
          sharedCampaign(campaignId).keys().hasAll(['gmUids']) &&
          request.auth.uid in sharedCampaign(campaignId).gmUids
        )
      );
    }

    function isLinkedCharacterOwner(campaignId, characterId) {
      let campaign = sharedCampaign(campaignId);
      return signedIn() &&
        campaign.keys().hasAll(['playerCharacterLinks']) &&
        campaign.playerCharacterLinks[characterId] == request.auth.uid;
    }

    function canUseCampaignSystems(campaignId) {
      return isCampaignMember(sharedCampaign(campaignId));
    }

    function canTransferLiveItems(campaignId) {
      return canUseCampaignSystems(campaignId) &&
        exists(/databases/$(database)/documents/campaigns/$(campaignId)/liveSession/current) &&
        get(/databases/$(database)/documents/campaigns/$(campaignId)/liveSession/current).data.status == 'active' &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'inventory', 'equipment', 'quickSlots', 'coins', 'coinPouch',
          'storages', 'storageLimit', 'actionLog', 'updatedAt'
        ]);
    }

    function isCampaignGM(campaignId) {
      let campaign = sharedCampaign(campaignId);
      return signedIn() && (
        campaign.ownerUid == request.auth.uid ||
        (campaign.keys().hasAll(['gmUids']) && request.auth.uid in campaign.gmUids)
      );
    }

    function hasActiveInvite(data, campaignId) {
      return signedIn() &&
        data.keys().hasAll(['ucn']) &&
        exists(/databases/$(database)/documents/campaignInvites/$(data.ucn)) &&
        get(/databases/$(database)/documents/campaignInvites/$(data.ucn)).data.status == 'active' &&
        get(/databases/$(database)/documents/campaignInvites/$(data.ucn)).data.campaignId == campaignId;
    }

    function joinsCampaignAsSelf(campaignId) {
      return signedIn() &&
        hasActiveInvite(resource.data, campaignId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.ucn == resource.data.ucn &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'playerUids', 'roles', 'players', 'activity', 'updatedAt'
        ]) &&
        request.resource.data.playerUids.hasAll(resource.data.playerUids) &&
        request.resource.data.playerUids.size() <= resource.data.playerUids.size() + 1 &&
        request.auth.uid in request.resource.data.playerUids &&
        request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid]) &&
        request.resource.data.roles[request.auth.uid] == 'player' &&
        request.resource.data.players[request.auth.uid].uid == request.auth.uid &&
        request.resource.data.players[request.auth.uid].role == 'player';
    }

    function linksOwnedCharacter() {
      let characterId = request.resource.data.lastLinkedCharacterId;
      return isCampaignMember(resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'party', 'players', 'characters', 'playerCharacterLinks',
          'activity', 'lastLinkedCharacterId', 'updatedAt'
        ]) &&
        request.resource.data.party.hasAll(resource.data.party) &&
        request.resource.data.party.size() <= resource.data.party.size() + 1 &&
        characterId in request.resource.data.party &&
        request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid]) &&
        characterId in request.resource.data.players[request.auth.uid].characterIds &&
        request.resource.data.characters.diff(resource.data.characters).affectedKeys().hasOnly([characterId]) &&
        request.resource.data.characters[characterId].ownerUid == request.auth.uid &&
        request.resource.data.playerCharacterLinks.diff(resource.data.playerCharacterLinks).affectedKeys().hasOnly([characterId]) &&
        request.resource.data.playerCharacterLinks[characterId] == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if ownsUserData(uid);

      match /{document=**} {
        allow read, write: if ownsUserData(uid);
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /campaignInvites/{ucn} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /campaigns/{campaignId} {
      allow read: if isCampaignMember(resource.data) || hasActiveInvite(resource.data, campaignId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isCampaignOwner(resource.data) && request.resource.data.ownerUid == resource.data.ownerUid) || joinsCampaignAsSelf(campaignId) || linksOwnedCharacter();
      allow delete: if isCampaignOwner(resource.data);

      match /characters/{characterId} {
        allow read: if canReadCampaignCharacter(campaignId);
        allow create: if canWriteCampaignCharacter(campaignId, request.resource.data.ownerUid) || isLinkedCharacterOwner(campaignId, characterId);
        allow update: if (request.resource.data.ownerUid == resource.data.ownerUid && (canWriteCampaignCharacter(campaignId, resource.data.ownerUid) || isLinkedCharacterOwner(campaignId, characterId))) || canTransferLiveItems(campaignId);
        allow delete: if canWriteCampaignCharacter(campaignId, resource.data.ownerUid) || isLinkedCharacterOwner(campaignId, characterId);
      }

      match /systems/{systemId} {
        allow read: if canUseCampaignSystems(campaignId);
        allow create, update: if (systemId == 'encounter' && isCampaignGM(campaignId)) ||
          (systemId != 'encounter' && canUseCampaignSystems(campaignId));
        allow delete: if isCampaignOwner(sharedCampaign(campaignId));
      }

      match /liveSession/{sessionDocument} {
        allow read: if canUseCampaignSystems(campaignId);
        allow create, update: if isCampaignGM(campaignId);
        allow delete: if isCampaignOwner(sharedCampaign(campaignId));
      }

      match /sessions/{sessionId} {
        allow read: if canUseCampaignSystems(campaignId);
        allow create, update: if isCampaignGM(campaignId);
        allow delete: if isCampaignOwner(sharedCampaign(campaignId));

        match /presence/{uid} {
          allow read: if canUseCampaignSystems(campaignId);
          allow create, update: if ownsUserData(uid) || isCampaignGM(campaignId);
          allow delete: if ownsUserData(uid) || isCampaignGM(campaignId);
        }
      }

      match /events/{eventId} {
        allow read: if isCampaignGM(campaignId) ||
          (signedIn() && resource.data.targetOwnerUid == request.auth.uid);
        allow create: if isCampaignGM(campaignId);
        allow update: if isCampaignGM(campaignId) || (
          signedIn() &&
          resource.data.targetOwnerUid == request.auth.uid &&
          request.resource.data.targetOwnerUid == resource.data.targetOwnerUid &&
          request.resource.data.targetCharacterId == resource.data.targetCharacterId &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'deliveryStatus', 'acknowledged', 'acknowledgedBy',
            'acknowledgedAt', 'resolvedAt', 'updatedAt'
          ])
        );
        allow delete: if isCampaignOwner(sharedCampaign(campaignId));
      }

      match /partyChat/{messageId} {
        allow read: if canUseCampaignSystems(campaignId);
        allow create: if canUseCampaignSystems(campaignId) &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 2000;
        allow update: if false;
        allow delete: if isCampaignGM(campaignId) ||
          (signedIn() && resource.data.ownerUid == request.auth.uid);
      }
    }

    match /customItems/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        hasValidMarketPricing(request.resource.data);
      allow update: if signedIn() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        hasValidMarketPricing(request.resource.data);
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
