rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function v2Member(campaignId,uid) {
      let member = firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/members/$(uid)).data;
      return member.get('uid', '') == uid &&
        member.get('campaignId', '') == campaignId &&
        member.get('status', '') == 'active' &&
        member.get('role', '') in ['co-gm','player'];
    }
    function v2GM(campaignId,uid) {
      let member = firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/members/$(uid)).data;
      return member.get('uid', '') == uid &&
        member.get('campaignId', '') == campaignId &&
        member.get('status', '') == 'active' &&
        member.get('role', '') == 'co-gm';
    }
    function campaignMember(campaignId) {
      let campaign = firestore.get(/databases/(default)/documents/campaigns/$(campaignId)).data;
      return request.auth != null && (
        campaign.get('membershipSchemaVersion',1) == 2
          ? (campaign.ownerUid == request.auth.uid || v2Member(campaignId,request.auth.uid))
          : (campaign.get('membershipSchemaVersion',1) == 1 && (
            campaign.ownerUid == request.auth.uid ||
            request.auth.uid in campaign.get('gmUids', []) ||
            request.auth.uid in campaign.get('playerUids', []) ||
            campaign.get('roles', {}).get(request.auth.uid, '') in ['gm','player']
          ))
      );
    }
    function campaignGM(campaignId) {
      let campaign = firestore.get(/databases/(default)/documents/campaigns/$(campaignId)).data;
      return request.auth != null && (
        campaign.get('membershipSchemaVersion',1) == 2
          ? (campaign.ownerUid == request.auth.uid || v2GM(campaignId,request.auth.uid))
          : (campaign.get('membershipSchemaVersion',1) == 1 && (
            campaign.ownerUid == request.auth.uid ||
            request.auth.uid in campaign.get('gmUids', []) ||
            campaign.get('roles', {}).get(request.auth.uid, '') == 'gm'
          ))
      );
    }
    match /campaigns/{campaignId}/sessionRecordings/{archiveId}/{fileName} {
      // Private recording bytes; published recordings are only readable by
      // active members. No downloadable token or Storage listing is exposed.
      allow get: if fileName.matches('recording\\.(webm|ogg|m4a)') &&
        (campaignGM(campaignId) ||
          (campaignMember(campaignId) &&
            firestore.exists(/databases/(default)/documents/campaigns/$(campaignId)/recordingArchives/$(archiveId)) &&
            firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/recordingArchives/$(archiveId)).data.get('status','') == 'ready' &&
            firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/recordingArchives/$(archiveId)).data.get('visibility','gm') == 'players'));
      allow list: if false;
      allow create: if campaignGM(campaignId) && resource == null &&
        firestore.exists(/databases/(default)/documents/campaigns/$(campaignId)/recordingArchives/$(archiveId)) &&
        firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/recordingArchives/$(archiveId)).data.get('status','') == 'uploading' &&
        request.resource.size > 0 && request.resource.size <= 40 * 1024 * 1024 &&
        ((fileName == 'recording.webm' && request.resource.contentType == 'audio/webm') ||
         (fileName == 'recording.ogg' && request.resource.contentType == 'audio/ogg') ||
         (fileName == 'recording.m4a' && request.resource.contentType == 'audio/mp4'));
      allow update: if false;
      allow delete: if campaignGM(campaignId);
    }
    match /campaigns/{campaignId}/audioTracks/{trackId}/{fileName} {
      // No public download URLs. A GM can preview private assets; players
      // can read bytes only for explicitly published, ready audio.
      allow get: if fileName.matches('audio\\.(mp3|ogg|wav|webm)') &&
        (campaignGM(campaignId) ||
          (campaignMember(campaignId) &&
            firestore.exists(/databases/(default)/documents/campaigns/$(campaignId)/audioTracks/$(trackId)) &&
            firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/audioTracks/$(trackId)).data.get('visibility','gm') == 'players' &&
            firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/audioTracks/$(trackId)).data.get('status','') == 'ready'));
      allow list: if false;
      allow create: if campaignGM(campaignId) && resource == null &&
        firestore.exists(/databases/(default)/documents/campaigns/$(campaignId)/audioTracks/$(trackId)) &&
        firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/audioTracks/$(trackId)).data.get('status','') == 'uploading' &&
        (
          (fileName == 'audio.mp3' && request.resource.contentType == 'audio/mpeg') ||
          (fileName == 'audio.ogg' && request.resource.contentType == 'audio/ogg') ||
          (fileName == 'audio.wav' && request.resource.contentType == 'audio/wav') ||
          (fileName == 'audio.webm' && request.resource.contentType == 'audio/webm')
        ) &&
        request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024;
      allow update: if false;
      allow delete: if campaignGM(campaignId);
    }
    match /campaigns/{campaignId}/sessionPdfs/{pdfId}/{fileName} {
      // Authenticated PDF reads; sharing is controlled by the server-projected index.
      allow get: if fileName == 'document.pdf' && (campaignGM(campaignId) ||
        (campaignMember(campaignId) &&
          firestore.exists(/databases/(default)/documents/campaigns/$(campaignId)/sessionPdfs/$(pdfId)) &&
          firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/sessionPdfs/$(pdfId)).data.get('visibility','gm') == 'players' &&
          firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/sessionPdfs/$(pdfId)).data.get('status','') == 'ready'));
      allow list: if false;
      allow create: if fileName == 'document.pdf' && campaignGM(campaignId) && resource == null &&
        firestore.exists(/databases/(default)/documents/campaigns/$(campaignId)/sessionPdfs/$(pdfId)) &&
        firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/sessionPdfs/$(pdfId)).data.get('status','') == 'uploading' &&
        request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
      allow update: if false;
      allow delete: if campaignGM(campaignId);
    }
    match /campaigns/{campaignId}/worldAtlas/{mapId}/{fileName} {
      // Authenticated blobs, never downloadable token URLs.
      allow get: if campaignGM(campaignId) ||
        (campaignMember(campaignId) &&
          firestore.exists(/databases/(default)/documents/campaigns/$(campaignId)/worldAtlasShared/$(mapId)) &&
          firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/worldAtlasShared/$(mapId)).data.get('visibility','gm') == 'players');
      allow list: if false;
      allow create: if campaignGM(campaignId) && resource == null &&
        firestore.exists(/databases/(default)/documents/campaigns/$(campaignId)/worldAtlas/$(mapId)) &&
        fileName in ['atlas.png','atlas.jpg','atlas.webp','atlas.gif'] &&
        request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow update: if false;
      allow delete: if campaignGM(campaignId);
    }
    match /campaigns/{campaignId}/battleMaps/{mapId}/{fileName} {
      // Do not expose GM-only map bytes or permit players to overwrite media.
      // Browser preview uses authenticated Storage getBlob, not public download URLs.
      allow get: if campaignGM(campaignId) ||
        (campaignMember(campaignId) &&
          firestore.exists(/databases/(default)/documents/campaigns/$(campaignId)/battleMaps/$(mapId)) &&
          firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/battleMaps/$(mapId)).data.get('visibility','gm') == 'players');
      allow list: if false;
      allow create: if campaignGM(campaignId) && resource == null &&
        fileName.matches('scene\\.(png|jpg|webp|gif|mp4|webm)') &&
        request.resource.size > 0 &&
        ((request.resource.contentType.matches('image/(png|jpeg|webp|gif)') &&
          request.resource.size <= 8 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/(mp4|webm)') &&
          request.resource.size <= 48 * 1024 * 1024));
      allow update: if false;
      allow delete: if campaignGM(campaignId);
    }

    match /campaigns/{campaignId}/artwork/{fileName} {
      allow read: if campaignMember(campaignId);
      allow create: if campaignGM(campaignId) &&
        request.resource.size > 0 &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow delete: if campaignGM(campaignId);
    }
    // Private account profile photo; only the authenticated owner can read,
    // create, replace or remove this fixed-path 512px cropped WEBP.
    match /users/{uid}/profile/avatar {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType == 'image/webp';
    }
    match /users/{uid}/characters/{characterId}/gallery/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid ||
        ('campaignId' in resource.metadata && campaignMember(resource.metadata.campaignId)));
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
