rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function v2Member(campaignId,uid) {
      let member = firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/members/$(uid)).data;
      return member.get('uid', '') == uid &&
        member.get('campaignId', '') == campaignId &&
        member.get('status', '') == 'active' &&
        member.get('role', '') in ['co-gm','player'];
    }
    function v2GM(campaignId,uid) {
      let member = firestore.get(/databases/(default)/documents/campaigns/$(campaignId)/members/$(uid)).data;
      return member.get('uid', '') == uid &&
        member.get('campaignId', '') == campaignId &&
        member.get('status', '') == 'active' &&
        member.get('role', '') == 'co-gm';
    }
    function campaignMember(campaignId) {
      let campaign = firestore.get(/databases/(default)/documents/campaigns/$(campaignId)).data;
      return request.auth != null && (
        campaign.get('membershipSchemaVersion',1) == 2
          ? (campaign.ownerUid == request.auth.uid || v2Member(campaignId,request.auth.uid))
          : (campaign.get('membershipSchemaVersion',1) == 1 && (
            campaign.ownerUid == request.auth.uid ||
            request.auth.uid in campaign.get('gmUids', []) ||
            request.auth.uid in campaign.get('playerUids', []) ||
            campaign.get('roles', {}).get(request.auth.uid, '') in ['gm','player']
          ))
      );
    }
    function campaignGM(campaignId) {
      let campaign = firestore.get(/databases/(default)/documents/campaigns/$(campaignId)).data;
      return request.auth != null && (
        campaign.get('membershipSchemaVersion',1) == 2
          ? (campaign.ownerUid == request.auth.uid || v2GM(campaignId,request.auth.uid))
          : (campaign.get('membershipSchemaVersion',1) == 1 && (
            campaign.ownerUid == request.auth.uid ||
            request.auth.uid in campaign.get('gmUids', []) ||
            campaign.get('roles', {}).get(request.auth.uid, '') == 'gm'
          ))
      );
    }
    match /campaigns/{campaignId}/artwork/{fileName} {
      allow read: if campaignMember(campaignId);
      allow create: if campaignGM(campaignId) &&
        request.resource.size > 0 &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow delete: if campaignGM(campaignId);
    }
    // Private account profile photo; only the authenticated owner can read,
    // create, replace or remove this fixed-path 512px cropped WEBP.
    match /users/{uid}/profile/avatar {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType == 'image/webp';
    }
    match /users/{uid}/characters/{characterId}/gallery/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid ||
        ('campaignId' in resource.metadata && campaignMember(resource.metadata.campaignId)));
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
